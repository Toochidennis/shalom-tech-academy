DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # React SPA fallback. Real files and folders are served directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Assets are referenced relatively, so /about/ would resolve them against
  # /about/ and 404. Send trailing-slash routes to their canonical form.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  RewriteRule ^ index.html [L]
</IfModule>
